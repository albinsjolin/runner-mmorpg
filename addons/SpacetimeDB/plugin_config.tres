[gd_resource type="Resource" script_class="SpacetimeDBPluginConfig" load_steps=4 format=3]

[ext_resource type="Script" path="res://addons/SpacetimeDB/core_types/plugin_config.gd" id="1_cfg"]
[ext_resource type="Script" path="res://addons/SpacetimeDB/core_types/module_config.gd" id="2_mod"]

[sub_resource type="Resource" id="Resource_runner"]
script = ExtResource("2_mod")
name = "runner"
alias = "Runner"
hide_scheduled_reducers = true
hide_private_tables = true
unparsed_module_schema = ""

[resource]
script = ExtResource("1_cfg")
autoload_name = "SpacetimeDB"
uri = "http://127.0.0.1:3000"
module_configs = Dictionary[String, ExtResource("2_mod")]({
"runner": SubResource("Resource_runner")
})
